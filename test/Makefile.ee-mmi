# Build one unified test+benchmark executable for PS2 Linux (o32).
# Run from the repository root: make -f test/Makefile.ee-mmi EE_CC=...
EE_CC ?= mipsel-linux-gnu-gcc
EE_CFLAGS ?= -O2 -Wall
EE_ASFLAGS ?=
EE_LDFLAGS ?=
BUILD ?= .ee-mmi-build
OUT ?= ee-mmi-suite

ASM = pixman/pixman-ee-mmi-asm.S \
      pixman/pixman-ee-mmi-over-asm.S \
      pixman/pixman-ee-mmi-ca-asm.S \
      pixman/pixman-ee-mmi-a8-asm.S \
      pixman/pixman-ee-mmi-image-a8-asm.S \
      pixman/pixman-ee-mmi-image-ca-asm.S \
      pixman/pixman-ee-mmi-565-asm.S \
      pixman/pixman-ee-mmi-scale-asm.S
OBJS = $(BUILD)/suite.o $(BUILD)/bench.o \
       $(BUILD)/ca.o $(BUILD)/a8.o $(BUILD)/rgb565.o $(BUILD)/image_a8.o $(BUILD)/image_ca.o

.PHONY: all clean
all: $(OUT)
$(BUILD):
	mkdir -p $(BUILD)
$(BUILD)/suite.o: test/ee-mmi-suite.c | $(BUILD)
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@
$(BUILD)/bench.o: test/ee-mmi-bench.c | $(BUILD)
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@
$(BUILD)/ca.o: test/ee-mmi-ca-fused-test.c | $(BUILD)
	$(EE_CC) $(EE_CFLAGS) -Dmain=ee_test_ca -c $< -o $@
$(BUILD)/a8.o: test/ee-mmi-a8-fused-test.c | $(BUILD)
	$(EE_CC) $(EE_CFLAGS) -Dmain=ee_test_solid_a8 -c $< -o $@
$(BUILD)/image_ca.o: test/ee-mmi-image-ca-fused-test.c | $(BUILD)
	$(EE_CC) $(EE_CFLAGS) -Dmain=ee_test_image_ca -c $< -o $@
$(BUILD)/image_a8.o: test/ee-mmi-image-a8-fused-test.c | $(BUILD)
	$(EE_CC) $(EE_CFLAGS) -Dmain=ee_test_image_a8 -c $< -o $@
$(BUILD)/rgb565.o: test/ee-mmi-565-fused-test.c | $(BUILD)
	$(EE_CC) $(EE_CFLAGS) -Dmain=ee_test_565 -c $< -o $@
$(OUT): $(OBJS) $(ASM)
	$(EE_CC) $(EE_CFLAGS) $(EE_ASFLAGS) $(EE_LDFLAGS) -o $@ $(OBJS) $(ASM)
clean:
	rm -rf $(BUILD) $(OUT)

# Native C reference build checks test harnesses without an EE assembler.
# This is NOT an EE code correctness/ABI/clock validation.
HOST_CC ?= cc
HOST_CFLAGS ?= -O2 -Wall -Wextra -std=c99
HOST_OUT ?= ee-mmi-host-suite
HOST_BUILD ?= .ee-mmi-host-build
HOST_OBJS = $(HOST_BUILD)/suite.o $(HOST_BUILD)/bench.o \
            $(HOST_BUILD)/ca.o $(HOST_BUILD)/a8.o \
            $(HOST_BUILD)/rgb565.o $(HOST_BUILD)/image_a8.o \
            $(HOST_BUILD)/image_ca.o \
            $(HOST_BUILD)/reference.o
.PHONY: host-check
host-check: $(HOST_OUT)
	./$(HOST_OUT) --test-only
$(HOST_BUILD):
	mkdir -p $(HOST_BUILD)
$(HOST_BUILD)/suite.o: test/ee-mmi-suite.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -c $< -o $@
$(HOST_BUILD)/bench.o: test/ee-mmi-bench.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -c $< -o $@
$(HOST_BUILD)/ca.o: test/ee-mmi-ca-fused-test.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -Dmain=ee_test_ca -c $< -o $@
$(HOST_BUILD)/a8.o: test/ee-mmi-a8-fused-test.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -Dmain=ee_test_solid_a8 -c $< -o $@
$(HOST_BUILD)/rgb565.o: test/ee-mmi-565-fused-test.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -Dmain=ee_test_565 -c $< -o $@
$(HOST_BUILD)/image_ca.o: test/ee-mmi-image-ca-fused-test.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -Dmain=ee_test_image_ca -c $< -o $@
$(HOST_BUILD)/image_a8.o: test/ee-mmi-image-a8-fused-test.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -Dmain=ee_test_image_a8 -c $< -o $@
$(HOST_BUILD)/reference.o: test/ee-mmi-host-reference.c | $(HOST_BUILD)
	$(HOST_CC) $(HOST_CFLAGS) -c $< -o $@
$(HOST_OUT): $(HOST_OBJS)
	$(HOST_CC) $(HOST_CFLAGS) -o $@ $(HOST_OBJS)
